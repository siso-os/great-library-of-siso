# Project-local agent runtime state. Durable goals, handoffs, and bounded
# scratchpad checkpoints are tracked; generated runtime state is not.
.agents/**/runtime/
.agents/**/logs/
.agents/**/secrets/
.agents/**/credentials/
.agents/**/browser-profiles/
.agents/**/tmp/
.agents/**/*.log
!.agents/owners.log

# `site/` is intentionally not ignored: it is the generated publication artifact.
.serena/

# The Library building on a SISO machine also shelves its collections here. Each is its own
